                var json = eval("("+data+")");
                status = json.status;
            }
            console.log(data);
        },error:function(){
        }
    });
    return status;
}

//文件查看
//参数说明 preview_server：预览服务路径  file_server：文件服务路径 auth_token：安全校验 file_path：文件路径
function filePreview(preview_server,file_server,auth_token,file_path){
    var file_array = file_path.split("|");
    var file_len = file_array.length;
    if(file_len == 1){
        var url = file_server+file_array[0]+"?download=0&auth_token="+auth_token;
        var open_url = preview_server+"onlinePreview?url="+encodeURIComponent(Base64.encode(url));
        var newWin = window.open('','_blank');
        newWin.document.write('<body scroll="no" style="margin: 0px;padding: 0px;border:0px;overflow:hidden;"><iframe style="margin: 0px;padding: 0px;border: 0px;width:100%;height:100%" src="'+open_url+'"></iframe></body>');
        newWin.document.title = "文件预览";
    }else if(file_len>1){
        var fileUrl= "";
        for(var i = 0;i< file_len; i++ ){
            var url = file_server+file_array[i]+"?download=0&auth_token="+auth_token;
            fileUrl += url + "|";
        }

        fileUrl = fileUrl.substring(0,fileUrl.length-1);//多文件使用“|”字符隔开
        var open_url = preview_server+"picturesPreview?urls="+encodeURIComponent(Base64.encode(fileUrl));
        var newWin = window.open('','_blank');
        newWin.document.write('<body scroll="no" style="margin: 0px;padding: 0px;border:0px;overflow:hidden;"><iframe style="margin: 0px;padding: 0px;border: 0px;width:100%;height:100%" src="'+open_url+'"></iframe></body>');
        newWin.document.title = "文件预览";
    }
}


function getBlodUrl(url){
    var blod_arry = [];
    var xhr = new XMLHttpRequest();
    xhr.open("GET",url,true);
    xhr.responseType = 'blob';
    xhr.onload = function() {
        if(xhr.status ===200){
            var blob = this.response;
            var blod_url = window.URL.createObjectURL(blob); //创建下载的链接
            blod_arry.push(blod_url);
        }
    }
    xhr.onerror = function (error) {
        console.log(error)
    }
    //3.发送
    xhr.send();
    return blod_url;
}

