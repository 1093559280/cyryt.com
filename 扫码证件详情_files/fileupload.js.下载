
//为了安全性考虑 先校验token token校验成功再上传  否则知道地址即可上传
function getToken(username,password){
    var auth_token = "";
    jQuery.ajax({
        method: "POST",
        url: "/fileTokenCon/getToken",
        data: {"username": username,"password":password},
        async: false,//Ajax调用方式为异步。false:同步加载
        cache: false,
        success: function (data) {
            auth_token = data;
        }, error: function () {
            auth_token = "";
        }
    });
    return auth_token;
}


