//div_id：上传框div的id,sys_code:系统编号
//file_type:文件类型 用于选择文件的过滤和上传路径的判断
//            |
// 图片：image 视频：video 音频：audio 文本文件：txt Excel文件：xls/xlsx  word文档：doc/docx  pdf文档：pdf  其他：other
var uppy,file_path="";
function initUppy(more_upload_path,div_id,file_type) {
    //判断文件过滤类型
    var allowedFileTypes = [];
    if (file_type == "image") {
        allowedFileTypes.push("image/*");
        file_path = "image";
    } else if (file_type == "video") {
        allowedFileTypes.push("video/*");
        file_path = "video";
    } else if (file_type == "audio") {
        allowedFileTypes.push("audio/*");
        file_path = "video";
    } else if (file_type == "txt") {
        allowedFileTypes.push("text/plain");
        file_path = "document";
    } else if (file_type == "xls/xlsx") {
        allowedFileTypes.push("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        allowedFileTypes.push("application/vnd.ms-excel");
        file_path = "document";
    } else if (file_type == "doc/docx") {
        allowedFileTypes.push("application/vnd.openxmlformats-officedocument.wordprocessingml.document");
        file_path = "document";
    } else if (file_type == "pdf") {
        allowedFileTypes.push("application/pdf");
        file_path = "document";
    } else if (file_type == "other") {
        allowedFileTypes.push("");
        file_path = "document";
    }
    //alert(file_path);
    uppy = new Uppy.Core({
        debug: true,
        autoProceed: false,
        locale: Uppy.locales.zh_CN,
        allowMultipleUploads: true, // 上传完成之后，是否可继续添加文件上传
        restrictions: {
            maxFileSize: 1024 * 1024 * 1024 * 4, // 以字节为单位
            maxNumberOfFiles: 100,//最大文件数
            minNumberOfFiles: 1,//最小文件数
            allowedFileTypes: allowedFileTypes,
            //requiredMetaFields: ['caption'],
        }
    }).use(Uppy.Dashboard, {
        inline: true,
        target: '#' + div_id,
        hideUploadButton: true,//隐藏自带的上传按钮
        metaFields: [
            { id: 'name', name: 'Name', placeholder: 'file name' },
            { id: 'caption', name: 'Caption', placeholder: 'describe what the image is about' }
        ],
        showProgressDetails: true,
        note: 'Images and video only, 2–3 files, up to 1 MB',
        height: 470,
        browserBackButtonClose: false
    }).use(Uppy.Tus, {
        endpoint: more_upload_path
    });
}

